<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.derekhanson.silvanus</string>
<key>CFBundleName</key><string>Silvanus</string>
<key>CFBundleDisplayName</key><string>Silvanus</string>
<key>CFBundleExecutable</key><string>Silvanus</string>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>__BUILD__</string>
<key>LSMinimumSystemVersion</key><string>26.0</string>
<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
<key>SUFeedURL</key><string>__FEED_URL__</string>
<key>SUPublicEDKey</key><string>__UPDATE_KEY__</string>
<key>SUEnableAutomaticChecks</key><true/>
<key>SUScheduledCheckInterval</key><integer>86400</integer>
<key>NSHighResolutionCapable</key><true/>
<key>NSPrincipalClass</key><string>NSApplication</string>
<key>NSMicrophoneUsageDescription</key><string>Silvanus records your microphone so your side of the call is in the transcript.</string>
<key>NSCalendarsFullAccessUsageDescription</key><string>Silvanus reads your calendar to title recordings and show what's coming up. It never changes your calendar.</string>
<key>NSAudioCaptureUsageDescription</key><string>Silvanus records call audio so the other people on the call are in the transcript.</string>
</dict></plist>
